# memoria deployment profile: pure lexical retrieval (no external model).
# Compiles with the Full gate "Add/Search uses gpt-4o-mini" because no model is
# called during Add or Search. Lowest cost, no external dependency.
# Copy to .env before `docker compose up --build`.

# --- Leaderboard API auth ---
MEMORIA_AUTH_SCHEME=bearer
MEMORIA_API_KEY=replace-with-a-long-random-secret

# --- Storage / limits ---
MEMORIA_DATA_DIR=./data
MEMORIA_RETENTION_DAYS=30
MEMORIA_MAX_TOP_K=1000

# --- Retrieval backends: no learned model, local SQLite FTS5 only ---
MEMORIA_EMBEDDING_BACKEND=none
MEMORIA_RERANKER_BACKEND=none
MEMORIA_RERANKER_CANDIDATE_LIMIT=200

# --- Model service: disabled (no values needed) ---
