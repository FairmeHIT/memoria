# memoria deployment profile: lexical retrieval + gpt-4o-mini reranking.
# The ONLY external model called during Search is gpt-4o-mini, so the Full gate
# "Add/Search uses gpt-4o-mini" checklist item is satisfied. Embeddings stay
# local (none) so no other model is used during Add/Search.
# You must supply your own OpenAI API key and pay the token cost.
# Copy to .env before deployment.

# --- Leaderboard API auth ---
MEMORIA_AUTH_SCHEME=bearer
MEMORIA_API_KEY=replace-with-a-long-random-secret

# --- Storage / limits ---
MEMORIA_DATA_DIR=./data
MEMORIA_RETENTION_DAYS=30
MEMORIA_MAX_TOP_K=1000

# --- Retrieval backends ---
# Embedding stays local lexical; the only remote model is the gpt-4o-mini reranker.
MEMORIA_EMBEDDING_BACKEND=none

MEMORIA_RERANKER_BACKEND=gpt4o
MEMORIA_GPT4O_API_KEY=replace-with-your-openai-compatible-api-key
MEMORIA_GPT4O_BASE_URL=https://api.openai.com/v1
MEMORIA_GPT4O_MODEL=gpt-4o-mini
MEMORIA_RERANKER_CANDIDATE_LIMIT=200

# --- Shared model client timeouts ---
MEMORIA_QWEN_TIMEOUT_SECONDS=15
MEMORIA_QWEN_RETRIES=2
