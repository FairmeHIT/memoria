# Required for any authenticated deployment. Do not commit a real value.
MEMORIA_API_KEY=replace-with-a-long-random-secret

# Supported values: bearer, token, x_api_key, none.
# Use none only for an intentionally public smoke environment.
MEMORIA_AUTH_SCHEME=bearer

# Persistent directory inside the container or local runtime.
MEMORIA_DATA_DIR=./data

# Evaluation data must be removed within 30 days unless retention is approved.
MEMORIA_RETENTION_DAYS=30

# The formal Leaderboard evaluation uses top_k=100. This is the accepted limit.
MEMORIA_MAX_TOP_K=1000

# Safe baseline for formal deployment: no model is used by Add/Search.
MEMORIA_EMBEDDING_BACKEND=none
MEMORIA_RERANKER_BACKEND=none

# Optional gpt-4o-mini reranking. If a submitted memory system uses a model
# during Search, configure it as gpt-4o-mini.
OPENAI_API_KEY=replace-with-your-openai-compatible-api-key
MEMORIA_GPT4O_BASE_URL=https://api.openai.com/v1
MEMORIA_GPT4O_MODEL=gpt-4o-mini
# MEMORIA_RERANKER_BACKEND=gpt4o

# Optional self-hosted BGE semantic retrieval for local ablations. Confirm
# current competition rules before enabling this in a submitted evaluation.
# API_KEY is accepted for compatibility with a deployed model service.
API_KEY=replace-with-your-self-hosted-model-api-key
MEMORIA_BGE_BASE_URL=http://127.0.0.1:8000
MEMORIA_BGE_AUTH_SCHEME=bearer
MEMORIA_BGE_EMBEDDING_MODEL=BAAI/bge-m3
MEMORIA_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MEMORIA_EMBEDDING_DIMENSIONS=1024
MEMORIA_RERANKER_CANDIDATE_LIMIT=200
MEMORIA_QWEN_TIMEOUT_SECONDS=15
MEMORIA_QWEN_RETRIES=2
