# memoria deployment profile: self-hosted BGE embedding + reranking.
# Strongest retrieval, requires a BGE service exposing /v1/embeddings and
# /v1/rerank (e.g. Xinference). NOTE: this uses BGE models, NOT gpt-4o-mini,
# so the Full gate "Add/Search uses gpt-4o-mini" item cannot be truthfully
# confirmed and reproduction review may invalidate the result.
# Copy to .env before `docker compose up --build`.

# --- Leaderboard API auth ---
MEMORIA_AUTH_SCHEME=bearer
MEMORIA_API_KEY=replace-with-a-long-random-secret

# --- Storage / limits ---
MEMORIA_DATA_DIR=./data
MEMORIA_RETENTION_DAYS=30
MEMORIA_MAX_TOP_K=1000

# --- BGE semantic retrieval ---
MEMORIA_EMBEDDING_BACKEND=bge
MEMORIA_BGE_BASE_URL=http://<bge-host>:8000
MEMORIA_BGE_AUTH_SCHEME=bearer
MEMORIA_BGE_API_KEY=replace-with-your-bge-service-key
MEMORIA_BGE_EMBEDDING_MODEL=BAAI/bge-m3
MEMORIA_EMBEDDING_DIMENSIONS=1024

MEMORIA_RERANKER_BACKEND=bge
MEMORIA_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MEMORIA_RERANKER_CANDIDATE_LIMIT=200

# --- Shared model client timeouts ---
MEMORIA_QWEN_TIMEOUT_SECONDS=15
MEMORIA_QWEN_RETRIES=2